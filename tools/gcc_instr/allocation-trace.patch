+   before find_free_reg_1 marks the chosen one.  */
+
 static int
 find_free_reg (class, mode, qty, accept_call_clobbered, just_try_suggested,
 	       born_index, dead_index)
      enum reg_class class;
      enum machine_mode mode;
+     int qty;
+     int accept_call_clobbered;
+     int just_try_suggested;
+     int born_index, dead_index;
+{
+  HARD_REG_SET live;
+  int ins, regno;
+  int num_copy_sugg = qty_phys_num_copy_sugg[qty];
+
+  CLEAR_HARD_REG_SET (live);
+  if (alloc_trace_stream ())
+    for (ins = born_index; ins < dead_index; ins++)
+      IOR_HARD_REG_SET (live, regs_live_at[ins]);
+
+  regno = find_free_reg_1 (class, mode, qty, accept_call_clobbered,
+			   just_try_suggested, born_index, dead_index);
+
+  if (alloc_trace_file)
+    {
+      fprintf (alloc_trace_file, "L   find q%d class=%s%s%s range=%d..%d -> %s; live in range ",
+	       qty, alloc_trace_class_name ((int) class),
+	       just_try_suggested ? (num_copy_sugg ? " copy-suggested-only"
+				     : " suggested-only") : "",
+	       qty_n_calls_crossed[qty] && ! accept_call_clobbered
+	       ? " call-saved-only" : "",
+	       born_index, dead_index, alloc_trace_reg_name (regno));
+      alloc_trace_regset (alloc_trace_file, live);
+      fprintf (alloc_trace_file, "\n");
+    }
+  return regno;
+}
