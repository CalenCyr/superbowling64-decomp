+/* Allocation trace (instrumented build only).  When the environment
+   variable GCC_ALLOC_TRACE names a file (or is "-" for stderr), local-alloc,
+   global-alloc and reload append their decisions to it.  Tracing only
+   prints: it never changes an allocation decision.  */
+
+extern char *getenv ();
+extern char *(*decl_printable_name) ();
+extern char *main_input_filename;
+
+FILE *alloc_trace_file;
+static int alloc_trace_checked;
+static char *alloc_trace_class_names[] = REG_CLASS_NAMES;
+
+FILE *
+alloc_trace_stream ()
+{
+  if (! alloc_trace_checked)
+    {
+      char *name = getenv ("GCC_ALLOC_TRACE");
+
+      alloc_trace_checked = 1;
+      if (name != 0 && name[0] != 0)
+	alloc_trace_file = (strcmp (name, "-") == 0
+			    ? stderr : fopen (name, "a"));
+    }
+  return alloc_trace_file;
+}
+
+char *
+alloc_trace_class_name (class)
+     int class;
+{
+  return alloc_trace_class_names[class];
+}
+
+/* Print the hard registers in SET as { $2 $3 ... }.  */
+
+void
+alloc_trace_regset (file, set)
+     FILE *file;
+     HARD_REG_SET set;
+{
+  register int i;
+
+  fputs ("{", file);
+  for (i = 0; i < FIRST_PSEUDO_REGISTER; i++)
+    if (TEST_HARD_REG_BIT (set, i))
+      fprintf (file, " %s", reg_names[i]);
+  fputs (" }", file);
+}
+
+/* Print the name of hard register REGNO, or "-" for none.  */
+
+char *
+alloc_trace_reg_name (regno)
+     int regno;
+{
+  return regno >= 0 && regno < FIRST_PSEUDO_REGISTER ? reg_names[regno] : "-";
+}
+
+/* Print which user variables live in which pseudos (the DECL_RTL of each
+   parameter and of each variable in the function's block tree).  */
+
+static void
+alloc_trace_block_vars (file, block, depth)
+     FILE *file;
+     tree block;
+     int depth;
+{
+  tree decl, sub;
+
+  for (decl = BLOCK_VARS (block); decl; decl = TREE_CHAIN (decl))
+    if (TREE_CODE (decl) == VAR_DECL && DECL_NAME (decl) != 0
+	&& DECL_RTL (decl) != 0)
+      {
+	rtx x = DECL_RTL (decl);
+
+	fprintf (file, "V var %s depth=%d", IDENTIFIER_POINTER (DECL_NAME (decl)),
+		 depth);
+	if (GET_CODE (x) == REG)
+	  fprintf (file, " r%d\n", REGNO (x));
+	else if (GET_CODE (x) == MEM && GET_CODE (XEXP (x, 0)) == REG)
+	  fprintf (file, " mem(r%d)\n", REGNO (XEXP (x, 0)));
+	else
+	  fprintf (file, " %s\n", GET_RTX_NAME (GET_CODE (x)));
+      }
+  for (sub = BLOCK_SUBBLOCKS (block); sub; sub = TREE_CHAIN (sub))
+    alloc_trace_block_vars (file, sub, depth + 1);
+}
+
+/* Diagnostic knob (changes code; never for the build): GCC_ALLOC_FORCE_GLOBAL
+   = "FUNCTION:REGNO[,REGNO...]" leaves those block-local pseudos of FUNCTION
+   to global-alloc, to test whether a different allocator decision explains
+   a register difference.  */
+
+static int
+alloc_trace_forced_global (regno)
+     int regno;
+{
+  char *spec = getenv ("GCC_ALLOC_FORCE_GLOBAL");
+  char *name, *p;
+  int len;
+
+  if (spec == 0 || current_function_decl == 0)
+    return 0;
+  name = (*decl_printable_name) (current_function_decl, 2);
+  len = strlen (name);
+  if (strncmp (spec, name, len) != 0 || spec[len] != ':')
+    return 0;
+  for (p = spec + len + 1; *p; )
+    {
+      if (atoi (p) == regno)
+	return 1;
+      while (*p && *p != ',')
+	p++;
+      if (*p == ',')
+	p++;
+    }
+  return 0;
+}
+
+static void
+alloc_trace_function_header (file)
+     FILE *file;
+{
+  tree decl;
+  register int i;
+
+  fprintf (file, "\n=== %s (%s)\n",
+	   (*decl_printable_name) (current_function_decl, 2),
+	   main_input_filename);
+  for (decl = DECL_ARGUMENTS (current_function_decl); decl;
+       decl = TREE_CHAIN (decl))
+    if (DECL_NAME (decl) != 0 && DECL_RTL (decl) != 0)
+      {
+	rtx x = DECL_RTL (decl);
+
+	fprintf (file, "V parm %s", IDENTIFIER_POINTER (DECL_NAME (decl)));
+	if (GET_CODE (x) == REG)
+	  fprintf (file, " r%d\n", REGNO (x));
+	else
+	  fprintf (file, " %s\n", GET_RTX_NAME (GET_CODE (x)));
+      }
+  if (DECL_INITIAL (current_function_decl) != 0
+      && TREE_CODE (DECL_INITIAL (current_function_decl)) == BLOCK)
+    alloc_trace_block_vars (file, DECL_INITIAL (current_function_decl), 0);
+  fprintf (file, "P pseudos (regno: refs live_length calls_crossed basic_block):");
+  for (i = FIRST_PSEUDO_REGISTER; i < max_regno; i++)
+    if (reg_n_refs[i] != 0)
